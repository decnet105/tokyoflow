  "1_1_breakdown": {
    "chunk_timings": [
      {
        "idx": 0,
        "lang": "zh",
        "text": "这是日本职场中含金量极高的新人入职金句。",
        "start": 0.0,
        "end": 4.754014,
        "duration": 4.754014
      },
      {
        "idx": 1,
        "lang": "ja",
        "text": "お世話になります",
        "start": 4.754014,
        "end": 7.3000229999999995,
        "duration": 2.546009
      },
      {
        "idx": 2,
        "lang": "zh",
        "text": "直译为我将成为接受您照料的一方。注意艾蕾娜巧妙结合了自谦动词",
        "start": 7.3000229999999995,
        "end": 13.782041,
        "duration": 6.482018
      },
      {
        "idx": 3,
        "lang": "ja",
        "text": "いたします",
        "start": 13.782041,
        "end": 15.872902999999999,
        "duration": 2.090862
      },
      {
        "idx": 4,
        "lang": "zh",
        "text": "，瞬间树立起既专业又谦逊的职场管理形象。",
        "start": 15.872902999999999,
        "end": 20.698912,
        "duration": 4.826009
      }
    ],
    "total_dur": 20.698912
  },
