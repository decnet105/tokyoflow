  "1_2_breakdown": {
    "chunk_timings": [
      {
        "idx": 0,
        "lang": "zh",
        "text": "在日本快节奏的仓储物流行业中，主管一般不会用随意的",
        "start": 0.0,
        "end": 5.426009,
        "duration": 5.426009
      },
      {
        "idx": 1,
        "lang": "ja",
        "text": "早く",
        "start": 5.426009,
        "end": 7.348027,
        "duration": 1.922018
      },
      {
        "idx": 2,
        "lang": "zh",
        "text": "，而是使用地道的商务副词",
        "start": 7.348027,
        "end": 10.327052,
        "duration": 2.979025
      },
      {
        "idx": 3,
        "lang": "ja",
        "text": "速やかに",
        "start": 10.327052,
        "end": 12.513061,
        "duration": 2.186009
      },
      {
        "idx": 4,
        "lang": "zh",
        "text": "，意思是'在不造成停顿和拥堵的前提下迅速推进'。",
        "start": 12.513061,
        "end": 17.33907,
        "duration": 4.826009
      }
    ],
    "total_dur": 17.33907
  },
